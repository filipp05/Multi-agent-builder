# Copy to .env for Docker. Never commit real credentials.
# docker --env-file reads this file; scripts/run_mvp.py does NOT load it automatically.
MODEL_PROVIDER=bedrock
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_BEARER_TOKEN_BEDROCK=replace-with-your-private-bedrock-key
MODEL_BUDGET_USD=5
# Explicit estimates, USD per million tokens. Verify pricing for your selected model.
MODEL_INPUT_USD_PER_MILLION=0.06
MODEL_OUTPUT_USD_PER_MILLION=0.24
RENOVATION_DATA_DIR=/data
ALLOWED_HOSTS=localhost,127.0.0.1

# Local Codex mode requires installed CLI + personal login (not included in Docker).
CODEX_MODEL_ID=gpt-6-astra
# Optional standalone planning module; shared app uses CODEX_MODEL_ID above.
KARINA_MODEL=gpt-6-astra
# Optional test browser cache and internal evaluation judge helper; leave commented.
# PLAYWRIGHT_BROWSERS_PATH=/absolute/path/to/playwright-browsers
# ELIZA_HELPER=/absolute/path/to/authorized-evaluation-helper
